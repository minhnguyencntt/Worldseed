      "tests": [
        {
          "id": "TestFileStore_FrozenIDs/snapshot_lists_IDs_in_order",
          "kind": "unit",
          "name": "TestFileStore_FrozenIDs/snapshot_lists_IDs_in_order",
          "title": "FrozenIDs returns the snapshot's contribution IDs in snapshot order",
          "scenario": "Given a round whose snapshot.yaml lists contributions 'a' and 'b', When FrozenIDs is called for that round, Then it returns []string{'a','b'}",
          "command": "cd backend && go test -timeout 2m ./internal/contribution -run TestFileStore_FrozenIDs -v -count=1",
          "status": "passed",
          "detail": ""
        },
        {
          "id": "TestFileStore_FrozenIDs/missing_snapshot_returns_ErrNotFound",
          "kind": "unit",
          "name": "TestFileStore_FrozenIDs/missing_snapshot_returns_ErrNotFound",
          "title": "FrozenIDs returns ErrNotFound when the round has no snapshot",
          "scenario": "Given a round with no snapshot.yaml, When FrozenIDs is called, Then errors.Is(err, ErrNotFound) is true",
          "command": "cd backend && go test -timeout 2m ./internal/contribution -run TestFileStore_FrozenIDs -v -count=1",
          "status": "passed",
          "detail": ""
        },
        {
          "id": "TestFileStore_FrozenIDs/parent_directory_world_ID",
          "kind": "unit",
          "name": "TestFileStore_FrozenIDs/parent_directory_world_ID",
          "title": "FrozenIDs rejects a traversal world ID with a non-NotFound error",
          "scenario": "Given worldID '../x', When FrozenIDs is called, Then it returns a non-nil error that is not ErrNotFound",
          "command": "cd backend && go test -timeout 2m ./internal/contribution -run TestFileStore_FrozenIDs -v -count=1",
          "status": "passed",
          "detail": ""
        },
        {
          "id": "TestFileStore_FrozenIDs/slash_in_round_ID",
          "kind": "unit",
          "name": "TestFileStore_FrozenIDs/slash_in_round_ID",
          "title": "FrozenIDs rejects a round ID containing a path separator with a non-NotFound error",
          "scenario": "Given roundID 'a/b', When FrozenIDs is called, Then it returns a non-nil error that is not ErrNotFound",
          "command": "cd backend && go test -timeout 2m ./internal/contribution -run TestFileStore_FrozenIDs -v -count=1",
          "status": "passed",
          "detail": ""
        }
